<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: a plain white plate filling the whole 108dp
     viewport. Deliberately full bleed with no shape and no shadow - baking
     either one in is what made the old PNG render as a circle inside the
     launcher's own circular mask. The mask decides the silhouette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FFFFFF" />
</vector>
